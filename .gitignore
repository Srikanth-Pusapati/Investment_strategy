
# Generated Makefile
# (meta build system like autotools,
# can automatically generate from config.status script
# (which is called by configure script))
Makefile

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ---- Secrets & local state (NEVER COMMIT) ----
.env
.env.*
.env.example
*.log
state/

# ---- Daily log archive (DO commit) ----
# The live logs/bot.log stays ignored; at midnight it rotates to a per-day
# Mon_DD_YYYY.log (see __main__.dated_log_name), kept in the repo so any
# trading day can be re-analyzed later.
!logs/*_*_*.log

# ---- Generated artifacts ----
dashboard.html
track_record.html
ops/status_page.html
