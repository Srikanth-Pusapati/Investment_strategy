{"nodes": [{"id": "todo_2_vision_model", "label": "Scanner-Decision-Execute-Monitor Vision (discovery-driven, no watchlist)", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "todo_2_capital_preservation_stack", "label": "Capital-Preservation Stack", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No strategy can guarantee you never drop below principal (gaps/halts jump stops); the goal is SMALL, BOUNDED, SURVIVABLE losses via layered %-based caps, vol-targeted fractional-Kelly sizing, brackets, and the watchdog."}, {"id": "todo_2_margin_account_decision", "label": "Margin-only Account Decision", "file_type": "rationale", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alpaca is margin-only (no cash account), so the small live float is a margin account with ~2x buying power. Consequences: PDT guard is essential, and the no-leverage gross cap pins deployment to <=100% of equity so borrowed money is never used."}, {"id": "todo_2_no_leverage_cap", "label": "No-leverage Gross-exposure Cap", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "todo_2_pdt_guard", "label": "Pattern-Day-Trader Guard", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "todo_2_sector_cap", "label": "Sector Concentration Cap", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "todo_2_regime_filter", "label": "Market-regime Risk Multiplier", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "todo_2_time_stop", "label": "Deterministic Time-stop (MAX_HOLD_DAYS)", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "todo_2_thesis_decay", "label": "Thesis-decay / Signal-freshness Exit", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "todo_2_scale_out", "label": "Let-winners-run Scale-out", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "todo_2_min_conviction", "label": "Min-conviction Gate", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "todo_2_fractional_protection", "label": "Fractional-position Protection", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live default is fractional (small margin float) and fractional buys carry no exchange bracket, so the bot refuses any buy with no stop and the watchdog registers a stop on every fractional fill; the overnight/halt gap residual is irreducible."}, {"id": "todo_2_multi_user_northstar", "label": "Multi-user / Multi-tenant North Star", "file_type": "concept", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signals/scanner are global (compute once); decision-sizing, risk, execution, monitoring are per-account. Current architecture (pure signals, file-path-parameterized state/ledger) is already well-suited."}, {"id": "todo_2_regulatory_gate", "label": "Regulatory/Legal Gate (resolve before multi-user build)", "file_type": "rationale", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trading others' money may require IA/broker-dealer registration. Each person running their OWN instance with their OWN keys is a different posture than managing funds; settle the legal model before building 5.1-5.5."}, {"id": "todo_2_options_constraint", "label": "Options / IPO Small-account Constraints", "file_type": "rationale", "source_file": "Todo-2.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Options need ~$2-3k to be usable and IPOs aren't available via Alpaca's API; small accounts are equity/ETF/fractional only."}], "edges": [{"source": "todo_2_vision_model", "target": "readme_discovery_pipeline", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Todo-2.txt", "source_location": null, "weight": 1.0}, {"source": "todo_2_margin_account_decision", "target": "todo_2_no_leverage_cap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Todo-2.txt", "source_location": null, "weight": 1.0}, {"source": "todo_2_margin_account_decision", "target": "todo_2_pdt_guard", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Todo-2.txt", "source_location": null, "weight": 1.0}, {"source": "todo_2_no_leverage_cap", "target": "investment_strategy_risk_riskmanager", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Todo-2.txt", "source_location": null, "weight": 1.0}, {"source": "todo_2_pdt_guard", "target": "investment_strategy_risk_riskmanager_pdt_block", "relation": "references", "confidence": "INFERRED