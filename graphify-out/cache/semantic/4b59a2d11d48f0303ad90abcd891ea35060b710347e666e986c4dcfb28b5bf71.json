{"nodes": [{"id": "model_sequence_decision_cycle", "label": "Decision Cycle (15m slow brain)", "file_type": "concept", "source_file": "MODEL_SEQUENCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs every DECISION_INTERVAL_SECONDS (default 900s), only when market open; discovers, judges, sizes and places. The slow thesis brain, gated by kill switch for new buys."}, {"id": "model_sequence_watchdog_loop", "label": "Watchdog Loop (30s fast safety net)", "file_type": "concept", "source_file": "MODEL_SEQUENCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs every MONITOR_INTERVAL_SECONDS (default 30s) on a daemon thread; closing is NEVER gated. Can sell at any time even while the decision thread is blocked on the LLM."}, {"id": "model_sequence_two_clocks", "label": "Held-position Keep-vs-Sell on Two Clocks", "file_type": "concept", "source_file": "MODEL_SEQUENCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A held name is re-judged every 30s by price (deterministic stops) and every 15m by thesis (Claude can return sell); both routes pass through RiskManager."}, {"id": "model_sequence_time_stop_gap", "label": "Stale-thesis / Time-stop Exit Gap", "file_type": "rationale", "source_file": "MODEL_SEQUENCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Originally a name that quietly stops working but never hits a price stop and is never flagged by Claude would be held indefinitely; the deterministic time-stop / thesis-decay exit closes that gap."}], "edges": [{"source": "model_sequence_decision_cycle", "target": "investment_strategy_orchestrator_orchestrator_run", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "MODEL_SEQUENCE.md",