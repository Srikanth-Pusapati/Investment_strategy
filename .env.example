# ======================================================================
# Copy to .env and fill in. NEVER commit .env (it's gitignored below).
# ======================================================================

# --- Trading mode -----------------------------------------------------
# paper  = Alpaca paper account (fake money, same API)  <-- start here
# live   = real money. Requires KILL_SWITCH=off AND TRADING_MODE=live.
TRADING_MODE=paper

# Master kill switch. "on" blocks ALL new order placement, period.
# The watchdog can still close positions for safety, but nothing opens.
KILL_SWITCH=off

# --- Alpaca credentials ----------------------------------------------
# Paper and live use DIFFERENT keys. Get them from app.alpaca.markets.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave default for paper; set to https://api.alpaca.markets for live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# --- Claude / Anthropic ----------------------------------------------
# NOTE: a Claude Pro/Max subscription does NOT include API access. This is
# separate pay-as-you-go billing set up at console.anthropic.com.
ANTHROPIC_API_KEY=
# Decision model. All Opus tiers (4.8/4.7/4.6) are priced identically
# ($5/$25 per 1M in/out), so dropping to a lower Opus saves nothing — keep
# 4.8 for the best reasoning. The real cost lever is DECISION_EFFORT below.
DECISION_MODEL=claude-opus-4-8
# Thinking depth / token spend per decision call: low|medium|high|xhigh|max.
# Output tokens (incl. adaptive thinking) dominate cost, so this is the main
# dial. medium is a good cost/quality balance; lower to "low" to cut spend.
DECISION_EFFORT=medium

# --- Risk limits (HARD caps enforced in code, not by the LLM) --------
MAX_POSITION_PCT=5.0          # max % of equity in a single new position
MAX_SYMBOL_EXPOSURE_PCT=10.0  # max total % of equity per symbol
MAX_DAILY_LOSS_PCT=3.0        # halt new trades if day's loss exceeds this
MAX_OPEN_POSITIONS=15         # cap concurrent holdings
MIN_CASH_BUFFER_PCT=10.0      # never deploy below this % cash reserve
DEFAULT_STOP_LOSS_PCT=5.0     # bracket stop distance from entry
DEFAULT_TAKE_PROFIT_PCT=12.0  # bracket take-profit distance from entry

# --- Position sizing (survival-first: vol-targeted, fractional-Kelly) -
KELLY_FRACTION=0.5            # fraction of full Kelly (0 disables, sizes to cap)
TARGET_ANNUAL_VOL_PCT=25.0    # per-position volatility budget

# --- Options (DEFINED-RISK only; off by default) ---------------------
OPTIONS_ENABLED=off           # master gate for the options path
MAX_OPTION_PREMIUM_PCT=1.0    # max % equity as debit on one options play

# --- Benchmark to beat -----------------------------------------------
BENCHMARK_SYMBOL=QQQ          # SPY or QQQ — decisions gear toward excess return

# --- Signal source API keys (optional; providers degrade gracefully) -
FMP_API_KEY=                  # financialmodelingprep.com (fundamentals)
FINNHUB_API_KEY=              # finnhub.io (sentiment + insider transactions)
QUIVER_API_KEY=               # quiverquant.com (congressional trades)
FRED_API_KEY=                 # fred.stlouisfed.org (macro)
POLYGON_API_KEY=              # polygon.io (options flow)
# SEC EDGAR requires a descriptive User-Agent with contact info.
SEC_USER_AGENT=your-name your-email@example.com

# --- Read-only Robinhood via official Agentic Trading MCP (context only) --
# Uses Robinhood's OFFICIAL MCP endpoint (OAuth), READ tools only. Orders ALWAYS
# go through Alpaca + the RiskManager — we never call RH trade tools.
# NOTE: the agentic MCP is scoped to a SEPARATE dedicated/funded RH account, not
# your main portfolio. Verify the URL + token flow on Robinhood's own docs.
ROBINHOOD_ENABLED=off
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN=          # OAuth access token (Bearer) from Robinhood
# Leave blank on first run — the reader logs the MCP's available tools so you
# can fill in the exact positions/holdings tool name here.
ROBINHOOD_POSITIONS_TOOL=

# --- Loop cadence -----------------------------------------------------
DECISION_INTERVAL_SECONDS=1800   # how often the decision cycle runs (30m)
MONITOR_INTERVAL_SECONDS=30     # how often the watchdog checks positions
